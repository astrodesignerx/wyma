# Copy to .env.local and fill in. Never commit the filled-in file.

# --- Site ---
# Absolute base URL used for canonical tags, Open Graph, sitemap and robots.
# Defaults to https://www.wyma-newfrontiers.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Note: the contact form posts directly to FormSubmit (formsubmit.co) from the
